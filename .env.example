# ── Domein & TLS ────────────────────────────────────────────────
DOMAIN=portfolio.example.nl
ACME_EMAIL=keanu@example.nl

# ── Wachtwoorden ────────────────────────────────────────────────
SITE_PASSWORD=verander-mij
ADMIN_PASSWORD=verander-mij-ook

# Genereer met:  openssl rand -base64 48
SESSION_SECRET=verander-dit-in-een-lange-random-string-van-minimaal-32-tekens

# ── Database ────────────────────────────────────────────────────
DB_PASSWORD=verander-mij-db
# In Docker is dit automatisch geconfigureerd via docker-compose;
# voor lokaal `npm run dev` zet je hem zelf:
# DATABASE_URL=postgres://keanu:verander-mij-db@localhost:5432/keanu

# ── Storage ─────────────────────────────────────────────────────
# Pad waar uploads opgeslagen worden (in Docker: /data/uploads).
# Lokaal zonder Docker:
# UPLOAD_DIR=./data/uploads
